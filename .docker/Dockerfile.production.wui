FROM node:22-slim AS build

ARG API_URL=http://api:8765
ENV API_URL=${API_URL}

WORKDIR /wui
COPY personal-research/wui/package.json personal-research/wui/package-lock.json ./
RUN npm ci
COPY personal-research/wui ./
RUN npm run build

FROM node:22-slim

ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000

WORKDIR /wui
COPY --from=build /wui/.next/standalone ./
COPY --from=build /wui/.next/static ./.next/static

CMD ["node", "server.js"]
