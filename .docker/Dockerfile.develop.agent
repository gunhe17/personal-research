FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1

RUN \
    apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates git ripgrep && \
    rm -rf /var/lib/apt/lists/*

RUN \
    mkdir -p /opt/codex && \
    curl -fsSL "https://github.com/openai/codex/releases/latest/download/codex-package-$(uname -m)-unknown-linux-musl.tar.gz" | tar -xz -C /opt/codex && \
    ln -s /opt/codex/bin/codex /usr/local/bin/codex

RUN curl -fsSL https://claude.ai/install.sh | bash
RUN curl -fsSL https://x.ai/cli/install.sh | bash
ENV PATH="/root/.local/bin:/root/.grok/bin:${PATH}" \
    CLAUDE_CONFIG_DIR=/root/.claude \
    DISABLE_AUTOUPDATER=1 \
    GROK_MEMORY=0

WORKDIR /app

CMD ["python", "personal-research/agent/bin/server.py"]
